{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Payroll Input Deductions Tax Calculations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tax Calculations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workday Payroll List Tax Results for a Pay Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.workday.com/payroll-input/v1/payRuns/:payRunId/taxResults",
            "params": [
              {
                "name": "payRunId",
                "value": "pr_20260430_weekly_001",
                "type": "path",
                "description": "Unique identifier for the pay run"
              },
              {
                "name": "limit",
                "value": "20",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "0",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve aggregated tax calculation results for a completed pay run, broken down by tax type and jurisdiction."
        },
        {
          "info": {
            "name": "Workday Payroll Get Worker Tax Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.workday.com/payroll-input/v1/workers/:workerId/taxSummary",
            "params": [
              {
                "name": "workerId",
                "value": "w_100542",
                "type": "path",
                "description": "Unique identifier for the worker"
              },
              {
                "name": "taxYear",
                "value": "2026",
                "type": "query",
                "description": "Tax year (defaults to current year)"
              }
            ]
          },
          "docs": "Retrieve a year-to-date tax summary for a worker, including total withholdings by jurisdiction and tax type."
        }
      ]
    }
  ],
  "bundled": true
}